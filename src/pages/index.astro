---
import Layout from '../layouts/LayoutPage.astro';
import Card from '../components/Card.astro';
import '../../public/styles/main.scss'
---

<Layout title="Index">
	<main id="MainPage">
		<section id="FirstSection">
			<div>
				<h2 class="container_title">Quien soy</h2>
				<p class="container_paragraph">Soy Kevin Marte, soy un programador con conocimientos de desarrollo de bots de Discord con alrededor de un año de experiencia como freelancer.</p>
			</div>
			<div>
				<h2 class="container_title">Soy</h2>
				<p class="container_paragraph">Soy Kevin Marte, soy un programador con conocimientos de desarrollo de bots de Discord con alrededor de un año de experiencia como freelancer.</p>
			</div>
		</section>

		<section id="Trabajos">
			<div>
				<video src="/src/proof.mp4" muted autoplay controls></video>
			</div>
			<div>
				<h2 class="container_title">Master Resell - Bot</h2>
				<p class="container_paragraph">
					Un bot cuyo objetivo es buscar informacion de productos en tiendas online y mandar dicha informacion a ciertas areas que el cliente desee.
				</p>
			</div>
		</section>

		<section>
			<div>
				<h2 class="container_title">Excel prices bot</h2>
				<p class="container_paragraph">
					Es un bot que busca informacion del precio comun de los celulares Iphone en reventa para luego sacar un promedio y ponerlo en una tabla de excel.	
				</p>
			</div>
			<div>
				<video src="/src/ExcelPrices.mp4" autoplay muted controls></video>
			</div>
		</section>

		<section>
			<div>
				<video src="/src/trabajo.mp4" autoplay muted controls></video>
			</div>
			<div>
				<h2 class="container_title">Generador de documentos</h2>
				<p class="container_paragraph">
					Un sistema para un sitio web que toma archivos PDF para luego aplicarles cierta plantilla de documentos mexicanos, con mas de 10 a elegir.
				</p>
			</div>
		</section>
	</main>
</Layout>

<script>
	const DownloadContainer: HTMLDivElement = document.getElementById('download_container') as HTMLDivElement


	window.addEventListener('DOMContentLoaded', () => {
		DownloadContainer.classList.add('download_active')
	})

</script>


