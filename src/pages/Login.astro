---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';
import '../../public/styles/main.scss'

---

<Layout title="Login">
	<main id="login_page">

		<div class="main_container_warning" id="warning">
			<h1 class="container_title">¡Uno de los datos ingresados es incorrecto!</h1>
		</div>

		<div id="login_container" class="container login_active">
			<h1 class="container_title_center">LOGIN</h1>
			<div id="login_inputsContainer">
				<h3 class="container_subtitle_mini">NOMBRE</h3>
				<input type="text" id="username" class="container_input">
				<h3 class="container_subtitle_mini">CONTRASEÑA</h3>
				<input type="text" id="password" class="container_input">
			</div>

			<button class="container_button" id="login_button">INICIAR SESION</button>
			<div>
				<a class="login_rememberPassword" href="">Recuperar contraseña</a>
			</div>
			<a class="login_rememberPassword" href="">Registrarse</a>
		</div>
	</main>
</Layout>

<script>


	const LoginContainer: HTMLDivElement = document.getElementById('login_container') as HTMLDivElement
	const LoginButton: HTMLButtonElement = document.getElementById('login_button') as HTMLButtonElement
	const UsernameInput: HTMLInputElement = document.getElementById('username') as HTMLInputElement
	const PasswordInput: HTMLInputElement = document.getElementById('password') as HTMLInputElement

	const Warning: HTMLDivElement = document.getElementById('warning') as HTMLDivElement


	function showWarning () {
		Warning.classList.add('warning_active')

		setTimeout(() => {
			Warning.classList.remove('warning_active')
		}, 3000);
	}
	LoginButton.addEventListener('click', () => {
		if (UsernameInput.value != 'kevin') return showWarning();
		if (PasswordInput.value != '123') return showWarning();

		location.href = '/'
	})


	
	
</script>
